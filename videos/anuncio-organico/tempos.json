 "words": [{"w": "Como", "start": 26.7, "end": 26.98}, {"w": "achar", "start": 26.98, "end": 27.26}, {"w": "temas", "start": 27.26, "end": 27.6}, {"w": "que", "start": 27.6, "end": 27.84}, {"w": "prendem,", "start": 27.84, "end": 28.3}, {"w": "como", "start": 28.3, "end": 28.74}, {"w": "escrever", "start": 28.74, "end": 29.12}, {"w": "o", "start": 29.12, "end": 29.36}, {"w": "roteiro", "start": 29.36, "end": 29.74}, {"w": "com", "start": 29.74, "end": 29.9}, {"w": "gancho,", "start": 29.98, "end": 30.42}, {"w": "como", "start": 30.6, "end": 30.8}, {"w": "gerar", "start": 30.8, "end": 31.2}, {"w": "a", "start": 31.2, "end": 31.28}, {"w": "voz,", "start": 31.28, "end": 31.56}, {"w": "quais", "start": 31.98, "end": 32.2}, {"w": "ferramentas", "start": 32.2, "end": 32.88}, {"w": "usar,", "start": 32.88, "end": 33.22}, {"w": "e", "start": 33.22, "end": 33.64}, {"w": "o", "start": 33.64, "end": 33.72}, {"w": "que", "start": 33.72, "end": 33.88}, {"w": "fazer", "start": 33.88, "end": 34.24}, {"w": "e", "start": 34.24, "end": 34.68}, {"w": "o", "start": 34.68, "end": 34.78}, {"w": "que", "start": 34.78, "end": 34.92}, {"w": "não", "start": 34.92, "end": 35.26}, {"w": "fazer.", "start": 35.26, "end": 35.7}]}, {"text": "Dá pra fazer pelo computador ou pelo celular Android, mesmo sem saber nada de animação.", "start": 36.1, "end": 41.46, "words": [{"w": "Dá", "start": 36.1, "end": 36.26}, {"w": "pra", "start": 36.26, "end": 36.4}, {"w": "fazer", "start": 36.4, "end": 36.7}, {"w": "pelo", "start": 36.7, "end": 36.94}, {"w": "computador", "start": 36.94, "end": 37.62}, {"w": "ou", "start": 37.62, "end": 37.9}, {"w": "pelo", "start": 37.9, "end": 38.12}, {"w": "celular", "start": 38.12, "end": 38.46}, {"w": "Android,", "start": 38.46, "end": 39.04}, {"w": "mesmo", "start": 39.22, "end": 39.64}, {"w": "sem", "start": 39.64, "end": 39.94}, {"w": "saber", "start": 39.94, "end": 40.28}, {"w": "nada", "start": 40.28, "end": 40.76}, {"w": "de", "start": 40.76, "end": 40.98}, {"w": "animação.", "start": 40.98, "end": 41.46}]}, {"text": "O curso completo custa só R$ 19,90.", "start": 41.78, "end": 44.84, "words": [{"w": "O", "start": 41.78, "end": 41.94}, {"w": "curso", "start": 41.94, "end": 42.16}, {"w": "completo", "start": 42.16, "end": 42.64}, {"w": "custa", "start": 42.64, "end": 43.16}, {"w": "só", "start": 43.16, "end": 43.36}, {"w": "R$", "start": 43.36, "end": 43.54}, {"w": "19,90.", "start": 43.54, "end": 44.84}]}, {"text": "Comenta 3D aqui embaixo, que eu te mando o link no direct.", "start": 44.84, "end": 47.86, "words": [{"w": "Comenta", "start": 44.84, "end": 45.22}, {"w": "3D", "start": 45.22, "end": 45.84}, {"w": "aqui", "start": 45.84, "end": 46.02}, {"w": "embaixo,", "start": 46.02, "end": 46.44}, {"w": "que", "start": 46.66, "end": 46.76}, {"w": "eu", "start": 46.76, "end": 46.84}, {"w": "te", "start": 46.84, "end": 46.94}, {"w": "mando", "start": 46.94, "end": 47.26}, {"w": "o", "start": 47.26, "end": 47.26}, {"w": "link", "start": 47.26, "end": 47.48}, {"w": "no", "start": 47.48, "end": 47.64}, {"w": "direct.", "start": 47.64, "end": 47.86}]}]}