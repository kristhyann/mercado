{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "slug": {
      "type": "string",
      "maxLength": 60,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "isDemo": {
      "default": false,
      "type": "boolean"
    },
    "active": {
      "default": true,
      "type": "boolean"
    },
    "description": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2000
        },
        {
          "type": "null"
        }
      ]
    },
    "seo": {
      "type": "object",
      "properties": {
        "title": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "description": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "image": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "branding": {
      "type": "object",
      "properties": {
        "logo": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "cover": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "primaryColor": {
          "default": "#6B21A8",
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{6})$"
        },
        "secondaryColor": {
          "default": "#F59E0B",
          "type": "string",
          "pattern": "^#([0-9a-fA-F]{6})$"
        }
      }
    },
    "banner": {
      "type": "object",
      "properties": {
        "enabled": {
          "default": true,
          "type": "boolean"
        },
        "image": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 1000
            },
            {
              "type": "null"
            }
          ]
        },
        "title": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "subtitle": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "contact": {
      "type": "object",
      "properties": {
        "whatsapp": {
          "type": "string",
          "pattern": "^\\d{12,15}$"
        },
        "instagram": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "address": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "region": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "mapsUrl": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "whatsapp"
      ]
    },
    "hours": {
      "type": "object",
      "properties": {
        "timezone": {
          "default": "America/Sao_Paulo",
          "type": "string"
        },
        "mode": {
          "default": "auto",
          "type": "string",
          "enum": [
            "auto",
            "open",
            "closed"
          ]
        },
        "whenClosed": {
          "default": "block",
          "type": "string",
          "enum": [
            "block",
            "schedule"
          ]
        },
        "ordersPaused": {
          "default": false,
          "type": "boolean"
        },
        "pausedMessage": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "weekly": {
          "default": {
            "sun": [],
            "mon": [],
            "tue": [],
            "wed": [],
            "thu": [],
            "fri": [],
            "sat": []
          },
          "type": "object",
          "properties": {
            "sun": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "open": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "close": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                },
                "required": [
                  "open",
                  "close"
                ]
              }
            },
            "mon": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "open": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "close": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                },
                "required": [
                  "open",
                  "close"
                ]
              }
            },
            "tue": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "open": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "close": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                },
                "required": [
                  "open",
                  "close"
                ]
              }
            },
            "wed": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "open": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "close": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                },
                "required": [
                  "open",
                  "close"
                ]
              }
            },
            "thu": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "open": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "close": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                },
                "required": [
                  "open",
                  "close"
                ]
              }
            },
            "fri": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "open": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "close": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                },
                "required": [
                  "open",
                  "close"
                ]
              }
            },
            "sat": {
              "default": [],
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "open": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  },
                  "close": {
                    "type": "string",
                    "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                  }
                },
                "required": [
                  "open",
                  "close"
                ]
              }
            }
          }
        },
        "special": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "date": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "label": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 2000
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "closed": {
                "default": false,
                "type": "boolean"
              },
              "intervals": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "open": {
                      "type": "string",
                      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                    },
                    "close": {
                      "type": "string",
                      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"
                    }
                  },
                  "required": [
                    "open",
                    "close"
                  ]
                }
              }
            },
            "required": [
              "date"
            ]
          }
        }
      }
    },
    "ordering": {
      "type": "object",
      "properties": {
        "delivery": {
          "default": true,
          "type": "boolean"
        },
        "pickup": {
          "default": true,
          "type": "boolean"
        },
        "minOrder": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "deliveryTime": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "pickupTime": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "paymentMethods": {
          "default": [
            "pix",
            "cash",
            "credit",
            "debit"
          ],
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "pix",
              "cash",
              "credit",
              "debit"
            ]
          }
        },
        "pixKey": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "delivery": {
      "type": "object",
      "properties": {
        "mode": {
          "default": "fixed",
          "type": "string",
          "enum": [
            "fixed",
            "zones",
            "free"
          ]
        },
        "fixedFee": {
          "default": 0,
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        },
        "freeAbove": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 100000
            },
            {
              "type": "null"
            }
          ]
        },
        "allowUnlistedNeighborhoods": {
          "default": false,
          "type": "boolean"
        },
        "zones": {
          "default": [],
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "neighborhood": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "fee": {
                "type": "number",
                "minimum": 0,
                "maximum": 100000
              },
              "active": {
                "default": true,
                "type": "boolean"
              }
            },
            "required": [
              "neighborhood",
              "fee"
            ]
          }
        }
      }
    },
    "whatsappMessage": {
      "type": "object",
      "properties": {
        "header": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        },
        "footer": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2000
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "icon": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "active": {
            "default": true,
            "type": "boolean"
          }
        },
        "required": [
          "key",
          "name"
        ]
      }
    },
    "addonGroups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "min": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "max": {
            "default": null,
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "free": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "extraPrice": {
            "default": 0,
            "type": "number",
            "minimum": 0,
            "maximum": 100000
          },
          "maxPerOption": {
            "default": 1,
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "addons": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 2000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "price": {
                  "default": 0,
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100000
                },
                "alwaysPaid": {
                  "default": false,
                  "type": "boolean"
                },
                "available": {
                  "default": true,
                  "type": "boolean"
                },
                "active": {
                  "default": true,
                  "type": "boolean"
                }
              },
              "required": [
                "key",
                "name"
              ]
            }
          }
        },
        "required": [
          "key",
          "name"
        ]
      }
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "extends": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "category": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "image": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          },
          "price": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100000
              },
              {
                "type": "null"
              }
            ]
          },
          "compareAtPrice": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 100000
              },
              {
                "type": "null"
              }
            ]
          },
          "variants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                "description": {
                  "anyOf": [
                    {
                      "type": "string",
                      "maxLength": 2000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "price": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100000
                },
                "compareAtPrice": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100000
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "available": {
                  "default": true,
                  "type": "boolean"
                },
                "rules": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "object",
                    "properties": {
                      "min": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      },
                      "max": {
                        "anyOf": [
                          {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "free": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    }
                  }
                }
              },
              "required": [
                "key",
                "name",
                "price"
              ]
            }
          },
          "variantLabel": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ]
          },
          "addonGroups": {
            "type": "array",
            "items": {
              "anyOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                {
                  "type": "object",
                  "properties": {
                    "group": {
                      "type": "string",
                      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                    },
                    "min": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "max": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 9007199254740991
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "free": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "group"
                  ]
                }
              ]
            }
          },
          "badges": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "mais-vendido",
                "promocao",
                "novo",
                "vegano",
                "zero-acucar",
                "destaque"
              ]
            }
          },
          "featured": {
            "type": "boolean"
          },
          "available": {
            "type": "boolean"
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "key"
        ]
      }
    }
  },
  "required": [
    "slug",
    "name",
    "branding",
    "contact"
  ]
}
