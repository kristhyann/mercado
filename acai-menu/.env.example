# ─────────────────────────────────────────────────────────────
# AÇAÍ MENU — variáveis de ambiente
# Copie para .env.local (desenvolvimento) e cadastre as mesmas na Vercel.
# NUNCA commite o arquivo .env.local.
# ─────────────────────────────────────────────────────────────

# URL pública do site (sem barra no final). Usada em links de compartilhamento,
# Open Graph e sitemap. Ex.: https://acaimenu.com.br
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API
# URL do projeto e chave "anon"/"publishable" (pública por natureza; o acesso é
# limitado por Row Level Security). Usadas SOMENTE no servidor do Next.js.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Chave "service_role"/"secret" — ADMINISTRATIVA.
# Usada APENAS pelos scripts de cadastro (npm run store:sync etc.) no seu computador.
# Não cadastre na Vercel. Não exponha no navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Bucket público do Supabase Storage onde ficam logos, capas e fotos.
SUPABASE_STORAGE_BUCKET=store-assets

# Segredo para o script de cadastro avisar o site que um cardápio mudou
# (revalidação imediata do cache). Gere um valor longo e aleatório.
# Cadastre o MESMO valor na Vercel e no seu .env.local.
REVALIDATE_SECRET=

# Modo de dados:
#   auto     → usa o Supabase se SUPABASE_URL/SUPABASE_ANON_KEY estiverem definidos;
#              caso contrário usa as lojas de demonstração da pasta /stores.
#   supabase → exige Supabase (recomendado em produção).
#   local    → sempre usa os arquivos da pasta /stores (somente desenvolvimento).
DATA_SOURCE=auto

# (Opcional) WhatsApp comercial da plataforma Açaí Menu, exibido na página
# inicial para açaiterias interessadas. Apenas dígitos com DDI+DDD. Ex.: 5511999999999
NEXT_PUBLIC_PLATFORM_WHATSAPP=

# ─── Painel administrativo (/admin) ──────────────────────────────────────────
# Em produção o painel usa o login do Supabase Auth (crie seu usuário com
# `npm run admin:create -- voce@email.com "senha"`). Nada a configurar aqui.
#
# SOMENTE DESENVOLVIMENTO, sem Supabase: senha para editar os arquivos da pasta
# /stores pelo painel. Ignorada na Vercel. Deixe vazio em produção.
ADMIN_LOCAL_PASSWORD=
